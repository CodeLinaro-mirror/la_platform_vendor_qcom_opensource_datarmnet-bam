load(":define_bam.bzl", "define_bam")
load("//build/kernel/kleaf:kernel.bzl", "ddk_headers", "ddk_module")

define_bam("shikra", "consolidate")
define_bam("shikra", "perf")

ddk_headers(
    name = "rmnet_msm_include_headers",
    hdrs = glob([
        "include/linux/*.h",
    ]),
    includes = [
        "include",
        "include/linux",
    ],
)

ddk_headers(
    name = "rmnet_msm_uapi_include_headers",
    hdrs = glob([
        "include/uapi/linux/*.h",
    ]),
    includes = [
        "include/uapi",
    ],
)

ddk_headers(
    name = "include_headers",
    hdrs = [
        ":rmnet_msm_include_headers",
        ":rmnet_msm_uapi_include_headers",
    ],
)
